# Insightful Report Agent reads .env from the project root. Process environment takes precedence.
# Fill in the sections for the features you use. Keep real credentials in private .env files.
# The INSIGHTFUL_REPORT_AGENT_ prefix applies to app settings. Provider and channel keys use
# their own names. Design Agent's DESIGN_AGENT_ prefix applies only to the other project.

# === 01. Lead model and provider credentials ===
# MODEL uses provider:model. DeepSeek V4.1 Flash defaults to https://api.deepseek.com and
# DEEPSEEK_API_KEY. For a compatible endpoint, set MODEL_BASE_URL and MODEL_API_KEY_ENV.
# MODEL_API_KEY_ENV holds the variable NAME (e.g. OPENROUTER_API_KEY), not the key value.
# MODEL_TIMEOUT_SECONDS applies to each model call. Blank MODEL_EFFORT uses provider defaults.
# CACHE_TTL applies only to providers supporting this setting (such as Anthropic).
INSIGHTFUL_REPORT_AGENT_MODEL=openai:deepseek-flash
INSIGHTFUL_REPORT_AGENT_MODEL_EFFORT=
INSIGHTFUL_REPORT_AGENT_MODEL_BASE_URL=
INSIGHTFUL_REPORT_AGENT_MODEL_API_KEY_ENV=
INSIGHTFUL_REPORT_AGENT_MODEL_TIMEOUT_SECONDS=600
INSIGHTFUL_REPORT_AGENT_CACHE_TTL=1h
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=
# Used for LangSmith sandboxes or gateway. Gateway model syntax is langsmith:provider/model.
LANGSMITH_API_KEY=
LANGSMITH_GATEWAY_API_KEY=

# === 02. Preprocessed sources ===
# Upload the result ZIP produced by Bulk Reference Files Preprocessor.
# Optional URL the agent can share when raw material needs to be preprocessed.
INSIGHTFUL_REPORT_AGENT_PREPROCESSOR_DOCS_URL=
# Optional host-side submission of raw attachments. Set the API origin without /docs.
INSIGHTFUL_REPORT_AGENT_PREPROCESSOR_API_URL=
BRFP_API_KEY=
INSIGHTFUL_REPORT_AGENT_PREPROCESSOR_TIMEOUT_SECONDS=3600
# Applies to the lead model's on-demand inspection of source figures.
INSIGHTFUL_REPORT_AGENT_SOURCE_VISUAL_ANALYSIS=true

# Optional Langfuse tracing. When configured it sends model and tool inputs and outputs.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENABLED=true

# === 03. Isolation, persistence, and runtime state ===
# auto prefers Docker. docker requires the configured image. langsmith requires a snapshot
# containing the report parser dependencies and a LangSmith key. Host execution is disabled.
# Idle TTL stops idle containers. Retention removes long-stopped workspace volumes; 0 keeps them.
# WORKSPACE_ROOT holds checkpoints and output. Use different roots for independent instances.
# DATABASE_URL selects Postgres (install --extra self-host). Blank uses SQLite.
INSIGHTFUL_REPORT_AGENT_SANDBOX=auto
INSIGHTFUL_REPORT_AGENT_SANDBOX_IMAGE=insightful-report-agent-sandbox:local
INSIGHTFUL_REPORT_AGENT_SANDBOX_SNAPSHOT=
INSIGHTFUL_REPORT_AGENT_SANDBOX_VCPUS=8
INSIGHTFUL_REPORT_AGENT_SANDBOX_MEM_GIB=16
INSIGHTFUL_REPORT_AGENT_SANDBOX_IDLE_TTL_SECONDS=600
INSIGHTFUL_REPORT_AGENT_SANDBOX_RETENTION_SECONDS=0
INSIGHTFUL_REPORT_AGENT_WORKSPACE_ROOT=workspace
DATABASE_URL=

# === 04. Channel behavior and optional MCP ===
# ENABLE_PROGRESS controls progress presentation in Feishu and Slack.
# TIMEZONE is the IANA timezone used for date context.
# External MCP tools are declared in config/mcp.toml. A provider key alone adds no MCP server.
INSIGHTFUL_REPORT_AGENT_ENABLE_PROGRESS=true
INSIGHTFUL_REPORT_AGENT_TIMEZONE=UTC

# === 05. Optional Feishu long connection (install --extra feishu) ===
# Fill these for the report bot. TENANT_KEY scopes incoming events to the intended organization.
# In the developer portal use long connection and subscribe to im.message.receive_v1.
# Feishu credentials are independent of Slack, the API, and Nacos credentials.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_KEY=

# === 06. Optional Slack adapter (install --extra slack) ===
# Socket Mode requires BOT_TOKEN and APP_TOKEN. Signed HTTP uses BOT_TOKEN and SIGNING_SECRET.
# With TRIGGER_ON_ALL_MESSAGES false, the bot handles DMs and mentions.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TRANSPORT=socket_mode
INSIGHTFUL_REPORT_AGENT_SLACK_TRIGGER_ON_ALL_MESSAGES=false

# === 07. HTTP listener and incoming authorization ===
# HOST/PORT control where serve binds. The same listener serves HTTP threads and A2A.
# ACCESS_TOKEN_CALLERS is a comma-separated mapping such as <token>:alice,<other-token>:bob.
# Clients use the token as the Bearer credential. Tokens mapped to one caller share access.
# Leaving it blank keeps protected requests disabled while the listener and Agent Card are available.
# This is independent of model, channel, and Nacos credentials.
INSIGHTFUL_REPORT_AGENT_API_HOST=127.0.0.1
INSIGHTFUL_REPORT_AGENT_API_PORT=8787
INSIGHTFUL_REPORT_AGENT_ACCESS_TOKEN_CALLERS=

# === 08. A2A protocol and Agent Card ===
# A2A is always mounted. Blank A2A_URL advertises the API bind address (or loopback for a wildcard).
# For remote clients or Nacos, set the reachable origin without /a2a or another path.
# Anonymous access defaults off. When enabled, all anonymous users share one caller.
# NAME is the logical agent name; VERSION versions the published Agent Card. The wire
# protocol remains A2A 1.0. Increment VERSION when changing a published immutable card.
INSIGHTFUL_REPORT_AGENT_A2A_URL=
INSIGHTFUL_REPORT_AGENT_A2A_ALLOW_ANONYMOUS=false
INSIGHTFUL_REPORT_AGENT_A2A_NAME=insightful-report-agent
INSIGHTFUL_REPORT_AGENT_A2A_VERSION=1.0.0
INSIGHTFUL_REPORT_AGENT_A2A_DOCUMENTATION_URL=

# === 09. Nacos 3.3 Agent Registry ===
# Blank NACOS_URL disables registration. Use the registry HTTP origin without /nacos or
# /next. Reporting clients call the advertised A2A origin directly.
# NAMESPACE is the namespace ID. Use an application account allowed to publish the definition
# and register/heartbeat runtime endpoints. For independent API configuration, put sections
# 07–09 in .env.a2a and launch with: uv run insightful-report-agent serve --api-only --env-file .env.a2a
INSIGHTFUL_REPORT_AGENT_NACOS_URL=
INSIGHTFUL_REPORT_AGENT_NACOS_NAMESPACE=public
INSIGHTFUL_REPORT_AGENT_NACOS_USERNAME=
INSIGHTFUL_REPORT_AGENT_NACOS_PASSWORD=
